{
  "name": "dusk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dusk — the market for compute that expires tonight.",
  "scripts": {
    "test": "(export PATH=\"$HOME/.foundry/bin:$PATH\"; command -v forge >/dev/null && cd contracts && forge build --silent || true) && vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "verify:bundle": "pnpm build:web && test -d apps/web/.next/static && ! grep -rqE '\\b(sk|mk)-[A-Za-z0-9_-]{16,}' apps/web/.next/static",
    "probe:og": "tsx scripts/probe-og.ts",
    "probe:arkiv": "tsx scripts/probe-arkiv.ts",
    "probe:swarm": "tsx scripts/probe-swarm.ts",
    "probe:image": "tsx scripts/probe-image.ts",
    "probe:image-producer": "tsx scripts/probe-image-producer.ts",
    "probe:tee": "tsx scripts/probe-tee.ts",
    "probe:tee-e2ee": "tsx scripts/probe-tee-e2ee.ts",
    "verify": "tsx scripts/verify-proof.ts",
    "build:escrow": "tsx scripts/build-escrow.ts",
    "verifier": "tsx scripts/verifier-bot.ts",
    "worker": "tsx worker/src/main.ts",
    "post-job": "tsx scripts/post-job.ts",
    "canary": "tsx scripts/canary.ts",
    "canary:loop": "tsx scripts/canary.ts --every 4h",
    "deploy:escrow": "tsx scripts/deploy-escrow.ts",
    "reclaim": "tsx scripts/reclaim-escrow.ts",
    "demo": "tsx scripts/demo-e2e.ts",
    "demo:split": "tsx scripts/demo-split.ts",
    "demo:recovery": "tsx scripts/demo-recovery.ts",
    "demo:refund": "tsx scripts/demo-refund.ts",
    "probe:browser": "tsx scripts/probe-browser.ts",
    "demo:private": "tsx scripts/demo-private.ts",
    "query": "tsx scripts/query-arkiv.ts",
    "probe:ens": "tsx scripts/probe-ens.ts",
    "ens:deploy": "tsx scripts/deploy-ens.ts",
    "ens:register": "tsx scripts/ens-register.ts",
    "ens:revoke": "tsx scripts/ens-revoke.ts",
    "index:ens": "tsx scripts/index-ens.ts",
    "attest:ens": "tsx scripts/attest-ens.ts",
    "propose:bans": "tsx scripts/propose-bans.ts",
    "reputation:deploy": "tsx scripts/deploy-reputation.ts",
    "reputation:prepare": "tsx scripts/prepare-reputation-workflow.ts",
    "build:reputation": "pnpm --filter @dusk/automation build",
    "test:reputation-runtime": "pnpm --filter @dusk/automation test:runtime",
    "mcp": "tsx mcp/src/main.ts"
  },
  "devDependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/node": "^26.6.6",
    "dotenv": "^17.2.3",
    "happy-dom": "21.0.4",
    "solc": "0.8.24",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "viem": "^2.57.13",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
