{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@dusk/core": ["../../packages/core/src/index.ts"],
      "@dusk/ens": ["../../packages/ens/src/index.ts"],
      "@dusk/core/credentials-file": ["../../packages/core/src/credentials-file.ts"],
      "@dusk/og": ["../../packages/og/src/index.ts"],
      "@dusk/arkiv": ["../../packages/arkiv/src/index.ts"],
      "@dusk/swarm": ["../../packages/swarm/src/index.ts"],
      "@dusk/escrow": ["../../packages/escrow/src/index.ts"],
      "@dusk/crypto": ["../../packages/crypto/src/index.ts"],
      "@dusk/buyer": ["../../packages/buyer/src/index.ts"],
      "@dusk/signer": ["../../packages/signer/src/index.ts"],
      "@dusk/worker/loop": ["../../worker/src/loop.ts"],
      "@dusk/worker/payout": ["../../worker/src/payout.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
